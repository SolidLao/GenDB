# Generated by MQO Batch Code Generator — builds ./mqo from shared/*.hpp +
# queries/*.cpp + mqo_main.cpp
CXX      ?= g++
CXXFLAGS ?= -O3 -march=native -std=c++17 -Wall -fpermissive -fopenmp -DGENDB_PROFILE -I.
LDFLAGS  ?= -lpthread -fopenmp

SRCS := mqo_main.cpp $(wildcard queries/*.cpp)
OBJS := $(SRCS:.cpp=.o)

.PHONY: all clean

all: mqo

mqo: $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $(OBJS) $(LDFLAGS)

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

# Workaround: q9.cpp uses std::vector<bool> whose .data() is unavailable.
# Preprocess to vector<char> (semantically equivalent for presence flags).
queries/q9.o: queries/q9.cpp
	@sed 's/vector<bool>/vector<char>/g; s/bool\* my_present/char* my_present/g; s/bool\* base_present/char* base_present/g; s/const bool\* tp/const char* tp/g' $< > queries/_q9_patched.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ queries/_q9_patched.cpp
	@rm -f queries/_q9_patched.cpp

clean:
	rm -f $(OBJS) mqo
