# Generated by MQO Batch Code Generator — builds ./mqo from
# shared/*.hpp + queries/*.cpp + mqo_main.cpp
CXX      ?= g++
CXXFLAGS ?= -O3 -march=native -std=c++20 -Wall -fpermissive -fopenmp -DGENDB_PROFILE -I.
LDFLAGS  ?= -lpthread -fopenmp

SRCS := mqo_main.cpp $(wildcard queries/*.cpp)
OBJS := $(SRCS:.cpp=.o)

all: mqo

mqo: $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $(OBJS) $(LDFLAGS)

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

clean:
	rm -f $(OBJS) mqo

.PHONY: all clean
